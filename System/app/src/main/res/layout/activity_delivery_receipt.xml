<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:fillViewport="true"
    tools:context=".frontEnd.DeliveryReceiptActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="←"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Delivery Service Receipt"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- Printable Receipt Container Card -->
        <LinearLayout
            android:id="@+id/receiptCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Receipt Header Branding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RoutGo Delivery Services"
                    android:textColor="#0B4F2C"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Official Delivery Request Receipt"
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#DDDDDD" />
            </LinearLayout>

            <!-- Tracking ID & Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRACKING ID"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReceiptTrackingId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DLV-10001"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INITIAL STATUS"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReceiptStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FEF3C7"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Pending"
                        android:textColor="#D97706"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvReceiptDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Date &amp; Time: Today, 10:30 AM"
                android:textColor="#555555"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#EEEEEE" />

            <!-- Sender Details -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SENDER DETAILS"
                android:textColor="#0B4F2C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptSenderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Name: Mark Santos"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptSenderContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact: 0917 123 4567"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptPickupAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pickup Address: Nasugbu, Batangas"
                android:textColor="#555555"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#EEEEEE" />

            <!-- Receiver Details -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RECEIVER DETAILS"
                android:textColor="#0B4F2C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptReceiverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Name: Ana Garcia"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptReceiverContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact: 0918 987 6543"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptDestinationAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Destination Address: Lian, Batangas"
                android:textColor="#555555"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#EEEEEE" />

            <!-- Package Details -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PACKAGE DETAILS"
                android:textColor="#0B4F2C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptPackageDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Description: Box of document files"
                android:textColor="#111111"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptPackageClassification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Classification: Lightweight"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptPackageWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weight: 2.5 kg"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptPackageDimensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dimensions: 25 x 15 x 10 cm"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptNumPackages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Number of Packages: 1"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptSpecialHandling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Special Instructions: Handle with care"
                android:textColor="#555555"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#DDDDDD" />

            <!-- Payment / Fee Summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="DELIVERY FEE &amp; TOTAL"
                android:textColor="#0B4F2C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nasugbu-Lian Base Fee:"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReceiptBaseFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱50.00"
                    android:textColor="#333333"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Weight &amp; Handling Charge:"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReceiptWeightCharge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱25.00"
                    android:textColor="#333333"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TOTAL AMOUNT:"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReceiptTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱75.00"
                    android:textColor="#0B4F2C"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnPrintSavePdf"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0B4F2C"
            android:text="🖨️ Print / Save PDF Receipt"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTrackPackage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0284C7"
            android:text="🗺️ Track Package Live"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDoneReceipt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#666666"
            android:text="Close &amp; Back to Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
