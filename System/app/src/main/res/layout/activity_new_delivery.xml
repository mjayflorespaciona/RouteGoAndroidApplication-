<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:fillViewport="true"
    tools:context=".frontEnd.NewDeliveryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="New Delivery"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- Pickup Location -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pickup Location"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pickupField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/editbox_background_normal"
            android:text="Nasugbu, Batangas"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Destination -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Destination"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/destinationField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/editbox_background_normal"
            android:text="Lian, Batangas"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Customer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Customer"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/customerField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/editbox_background_normal"
            android:text="Juan Dela Cruz"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Package / Item -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Package / Item"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/packageField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/editbox_background_normal"
            android:text="3 Items"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Date & Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Date &amp; Time"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dateTimeField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/editbox_background_normal"
            android:text="May 14, 2025 • 09:00 AM"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Vehicle (Optional) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Vehicle (Optional)"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/vehicleField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/editbox_background_normal"
            android:text="Select Vehicle"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Create Delivery Button -->
        <Button
            android:id="@+id/btnCreateDelivery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#0B4F2C"
            android:text="Create Delivery"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
