<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:fillViewport="true"
    tools:context=".frontEnd.NewDeliveryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="←"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="New Delivery Request"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section 1: Sender Information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sender Information"
                android:textColor="#0B4F2C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sender Name *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/senderNameField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Enter sender full name"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Contact Number *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/senderContactField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="0917 123 4567"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pickup Address *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pickupAddressField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:text="Nasugbu, Batangas"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />


            <!-- Section 2: Receiver Information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Receiver Information"
                android:textColor="#0B4F2C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Receiver Name *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/receiverNameField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Enter receiver full name"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Contact Number *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/receiverContactField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="0918 987 6543"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Delivery Address *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/deliveryAddressField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:text="Lian, Batangas"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />


            <!-- Section 3: Package Information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Package Information"
                android:textColor="#0B4F2C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Package Description *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/packageDescField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="e.g. Documents, Box, Electronics"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Package Type"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/packageTypeField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="e.g. Small Parcel / Standard / Fragile"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Delivery Notes (Optional)"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/deliveryNotesField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Special instructions for delivery rider"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />


            <!-- Section 4: Delivery Information & Route -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Delivery Information &amp; Route"
                android:textColor="#0B4F2C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pickup Location"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pickupLocationField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:text="Nasugbu, Batangas"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Destination (Route: Nasugbu - Lian)"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/destinationField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:text="Lian, Batangas"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Delivery Date"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/deliveryDateField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/editbox_background_normal"
                android:text="Today"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnCreateDelivery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#0B4F2C"
            android:text="Submit Delivery Request"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
