<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Customer Profile"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditSaveProfile"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#0B4F2C"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Header Card (Avatar, Name, Email) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Profile Picture Avatar Badge -->
                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#0B4F2C"
                    android:gravity="center"
                    android:text="CS"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Customer User"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="customer@example.com"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Account Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="#0B4F2C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Full Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Full Name"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:enabled="false"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <!-- Email Address (Read-only for security) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Email Address (Locked)"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:enabled="false"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <!-- Contact Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Contact Number"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etContactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:enabled="false"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <!-- Address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Delivery Address"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:enabled="false"
                    android:inputType="textPostalAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <!-- Account Type / Rider ID (Locked) -->
                <TextView
                    android:id="@+id/tvRoleOrRiderIdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Account Role / Rider ID (Locked)"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAccountRole"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:enabled="false"
                    android:text="Customer"
                    android:textColor="#0B4F2C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Assigned Vehicle (Locked) -->
                <TextView
                    android:id="@+id/tvAssignedVehicleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Assigned Vehicle (Admin Managed)"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAssignedVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:enabled="false"
                    android:hint="None"
                    android:textColor="#0B4F2C"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Delivery History Action -->
            <Button
                android:id="@+id/btnViewDeliveryHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#0B4F2C"
                android:text="📦 View My Delivery History"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- Security & Password Action -->
            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0284C7"
                android:text="Change Password"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- Logout Button with Confirmation -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#DC2626"
                android:text="Logout"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
