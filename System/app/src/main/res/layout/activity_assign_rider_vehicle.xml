<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:orientation="vertical"
    tools:context=".frontEnd.AssignRiderVehicleActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="←"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fleet &amp; Rider Management"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riders &amp; Vehicles Control"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Rider Summary Stats Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rider Overview"
                    android:textColor="#0B4F2C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Total Riders -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalRiders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Available Riders -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAvailableRiders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textColor="#16A34A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Available"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- On Delivery Riders -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOnDeliveryRiders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="#0284C7"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="On Delivery"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Off Duty Riders -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOffDutyRiders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="#64748B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Off Duty"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Vehicle Summary Stats Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vehicle Overview"
                    android:textColor="#0B4F2C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Total Vehicles -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalVehicles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Available Vehicles -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAvailableVehicles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6"
                            android:textColor="#16A34A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Available"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Vehicles In Use -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVehiclesInUse"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="#D97706"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In Use"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Vehicles Under Maintenance -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVehiclesMaintenance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#DC2626"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maintenance"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Segmented Control Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_role_tabs"
                android:orientation="horizontal"
                android:padding="2dp">

                <Button
                    android:id="@+id/tabRidersBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#0B4F2C"
                    android:text="Riders Management"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tabVehiclesBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="Vehicles Management"
                    android:textColor="#666666"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- SECTION 1: RIDERS MANAGEMENT -->
            <LinearLayout
                android:id="@+id/sectionRiders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Search Riders Bar -->
                <EditText
                    android:id="@+id/searchRiderField"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Search riders by name or Rider ID..."
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <!-- Rider Status Filter Chips Bar -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnFilterRiderAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#0B4F2C"
                            android:text="All"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterRiderAvailable"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="Available"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterRiderOnDelivery"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="On Delivery"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterRiderOffDuty"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="Off Duty"
                            android:textColor="#555555"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btnAddRider"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#0B4F2C"
                    android:text="+ Add New Rider"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <!-- Container for Rider List -->
                <LinearLayout
                    android:id="@+id/riderListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- SECTION 2: VEHICLES MANAGEMENT -->
            <LinearLayout
                android:id="@+id/sectionVehicles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Search Vehicles Bar -->
                <EditText
                    android:id="@+id/searchVehicleField"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Search vehicles by plate number or Vehicle ID..."
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <!-- Vehicle Type & Status Filter Chips Bar -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnFilterVehicleAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#0B4F2C"
                            android:text="All"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterVehicleMotorcycle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="Motorcycles"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterVehicleVan"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="Delivery Vans"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterVehicleAvailable"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="Available"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterVehicleInUse"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="In Use"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnFilterVehicleMaintenance"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#E5E7E6"
                            android:text="Under Maintenance"
                            android:textColor="#555555"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btnAddVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#0B4F2C"
                    android:text="+ Add New Vehicle"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <!-- Container for Vehicle List -->
                <LinearLayout
                    android:id="@+id/vehicleListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
