<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/menuIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="My Deliveries"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/searchField"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Search deliveries by ID, receiver, or location"
        android:inputType="text"
        android:autofillHints="name"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <!-- Filter Chips Horizontal Scroll View -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#0B4F2C"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E5E7E6"
                android:text="Pending"
                android:textColor="#555555"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterConfirmed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E5E7E6"
                android:text="Confirmed"
                android:textColor="#555555"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterAssigned"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E5E7E6"
                android:text="Assigned to Rider"
                android:textColor="#555555"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterInTransit"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E5E7E6"
                android:text="In Transit"
                android:textColor="#555555"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterDelivered"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E5E7E6"
                android:text="Delivered"
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- RecyclerView for Delivery Records -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewDeliveries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Empty View / Placeholder -->
    <TextView
        android:id="@+id/tvEmptyDeliveries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No deliveries found."
        android:textColor="#777777"
        android:textSize="14sp"
        android:visibility="gone"
        android:padding="24dp" />

</LinearLayout>
